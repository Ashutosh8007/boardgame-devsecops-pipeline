pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'Maven3'
    }

    environment {
        APP_DIR = 'app'
	DOCKERHUB_USER = 'ashutosh8007'
    }

    stages {

        stage('Checkout') {
            steps {
                echo "Checked out branch: ${env.GIT_BRANCH ?: 'unknown'}"
                sh 'git log -1 --oneline'
            }
        }

        stage('Build') {
            steps {
                dir("${APP_DIR}") {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir("${APP_DIR}") {
                    sh 'mvn package'
                }
            }
            post {
                always {
                    junit "${APP_DIR}/target/surefire-reports/*.xml"
                }
            }
        }
	
	stage('Trivy Filesystem Scan') {
            steps {
                dir("${APP_DIR}") {
                    catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                        sh '''
                            trivy fs --scanners vuln --severity HIGH,CRITICAL \
                              --timeout 10m --exit-code 0 --format json -o trivy-fs-report.json .
                            trivy fs --scanners vuln --severity HIGH,CRITICAL \
                              --timeout 10m --exit-code 0 .
                        '''
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: "${APP_DIR}/trivy-fs-report.json", allowEmptyArchive: true
                }
            }
        }	
	
	stage('Build Docker Image') {
            steps {
                dir("${APP_DIR}") {
                    sh "docker build -t ${DOCKERHUB_USER}/boardgame:${BUILD_NUMBER} -t ${DOCKERHUB_USER}/boardgame:latest ."
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                dir("${APP_DIR}") {
                    catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                        sh """
                            trivy image --scanners vuln --severity HIGH,CRITICAL \
                              --timeout 10m --exit-code 0 --format json -o trivy-image-report.json \
                              ${DOCKERHUB_USER}/boardgame:${BUILD_NUMBER}
                            trivy image --scanners vuln --severity HIGH,CRITICAL \
                              --timeout 10m --exit-code 0 ${DOCKERHUB_USER}/boardgame:${BUILD_NUMBER}
                        """
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: "${APP_DIR}/trivy-image-report.json", allowEmptyArchive: true
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKERHUB_UN', passwordVariable: 'DOCKERHUB_PW')]) {
                    sh '''
                        echo "$DOCKERHUB_PW" | docker login -u "$DOCKERHUB_UN" --password-stdin
                        docker push ${DOCKERHUB_USER}/boardgame:${BUILD_NUMBER}
                        docker push ${DOCKERHUB_USER}/boardgame:latest
                        docker logout
                    '''
                }
            }
        }	
       

        stage('SonarQube Analysis') {
            steps {
                dir("${APP_DIR}") {
                    withSonarQubeEnv('SonarQube') {
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                            sh "${tool 'SonarScanner'}/bin/sonar-scanner"
                        }
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig-boardgame', variable: 'KUBECONFIG_FILE')]) {
                    sh """
                        export KUBECONFIG=\$KUBECONFIG_FILE
                        helm upgrade --install boardgame ./helm/boardgame \
                          --set image.tag=${BUILD_NUMBER} \
                          --wait --timeout 5m
                    """
                }
            }
            post {
                always {
                    withCredentials([file(credentialsId: 'kubeconfig-boardgame', variable: 'KUBECONFIG_FILE')]) {
                        sh '''
                            export KUBECONFIG=$KUBECONFIG_FILE
                            kubectl get pods
                            kubectl get svc
                        '''
                    }
                }
            }
        }
        

        // NOTE: A blocking Quality Gate wait (waitForQualityGate) was
        // intentionally removed. On this resource-constrained WSL
        // environment, SonarQube's server-side Compute Engine report
        // processing is slow enough that Jenkins' own `timeout` step
        // would abort the ENTIRE BUILD when it expired - and that abort
        // bypasses catchError's UNSTABLE downgrade, defeating the resilience
        // pattern used for the Analysis stage above. The scan itself
        // completes and uploads successfully (see docs/troubleshooting.md);
        // results are available directly on the SonarQube dashboard without
        // Jenkins needing to block on them.
    }

    post {
        success {
            echo 'Build and tests passed.'
        }
        unstable {
            echo 'Build succeeded but SonarQube analysis did not complete cleanly - see docs/troubleshooting.md.'
        }
        failure {
            echo 'Build or tests failed - check the stage logs above.'
        }
    }
}
