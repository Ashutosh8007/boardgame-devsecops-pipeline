pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'Maven3'
    }

    environment {
        APP_DIR = 'app'
    }

    stages {

        stage('Checkout') {
            steps {
                echo "Checked out branch: ${env.GIT_BRANCH ?: 'unknown'}"
                sh 'git log -1 --oneline'
            }
        }

        stage('Build') {
            steps {
                dir("${APP_DIR}") {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir("${APP_DIR}") {
                    sh 'mvn package'
                }
            }
            post {
                always {
                    junit "${APP_DIR}/target/surefire-reports/*.xml"
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir("${APP_DIR}") {
                    withSonarQubeEnv('SonarQube') {
                        // catchError makes this stage best-effort: on this
                        // resource-constrained WSL environment, SonarQube's
                        // three internal JVM processes (Elasticsearch, Compute
                        // Engine, Web Server) periodically compete with Jenkins/
                        // Maven for memory, causing scan timeouts. Rather than
                        // let an infrastructure resource limit fail the entire
                        // pipeline, we mark this stage UNSTABLE and continue -
                        // see docs/troubleshooting.md for full root-cause analysis.
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                            sh "${tool 'SonarScanner'}/bin/sonar-scanner"
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            when {
                expression { currentBuild.result != 'FAILURE' }
            }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    timeout(time: 10, unit: 'MINUTES') {
                        waitForQualityGate abortPipeline: false
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Build and tests passed.'
        }
        unstable {
            echo 'Build succeeded but SonarQube analysis or Quality Gate did not complete cleanly - see docs/troubleshooting.md.'
        }
        failure {
            echo 'Build or tests failed - check the stage logs above.'
        }
    }
}
